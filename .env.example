# Coveo organization receiving search requests.
COVEO_ORGANIZATION_ID=

# Privileged authenticated-search key. Server-side only. Never expose with NEXT_PUBLIC_.
COVEO_PLATFORM_API_KEY=

# RoboMotion Commerce product search. These are non-secret defaults; the API key above remains server-only.
COVEO_COMMERCE_SEARCH_ENDPOINT=https://platform-eu.cloud.coveo.com/rest/organizations/robomotionindustriesp0bp5xin/commerce/v2/search
COVEO_COMMERCE_TRACKING_ID=robomotion
COVEO_COMMERCE_LANGUAGE=en
COVEO_COMMERCE_COUNTRY=GB
COVEO_COMMERCE_CURRENCY=GBP

# Live Search API support for query suggestions, RGA, and technical resources.
COVEO_SEARCH_API_BASE_URL=https://platform-eu.cloud.coveo.com/rest/search/v2
COVEO_QUERY_SUGGEST_SEARCH_HUB=robomotion
COVEO_QUERY_SUGGEST_PIPELINE=cmh-search-robomotion-05bd0bce
COVEO_RGA_SEARCH_HUB=robomotion
COVEO_RGA_PIPELINE=default
COVEO_CONTENT_SEARCH_HUB=robomotion
COVEO_CONTENT_PIPELINE=default

# Search context enforced in the generated search token.
COVEO_SEARCH_HUB=assessment-search
COVEO_PIPELINE=

# Anonymous is appropriate for the take-home unless Coveo provides a specific identity.
COVEO_USER_ID=anonymous
COVEO_IDENTITY_PROVIDER=Email Security Provider

# Comma-separated Coveo fields to facet on. Adjust after inspecting the provided index.
COVEO_FACET_FIELDS=source,filetype

# Optional override for HIPAA/non-standard orgs or legacy endpoints.
# COVEO_SEARCH_TOKEN_ENDPOINT=https://<ORG_ID>.org.coveo.com/rest/search/v2/token?organizationId=<ORG_ID>

# Feature flags for local/demo composition. These are read server-side in app/page.tsx.
# Set COVEO_FEATURE_SAMPLE_SEARCH_RESPONSE=false when real Coveo credentials should drive the UI.
COVEO_FEATURE_SAMPLE_SEARCH_RESPONSE=true
COVEO_FEATURE_FACETS=true
COVEO_FEATURE_FACET_CONTENT_TYPE=true
COVEO_FEATURE_FACET_SOURCE=true
COVEO_FEATURE_FACET_PRODUCT=true
COVEO_FEATURE_FACET_UPDATED_DATE=false
COVEO_FEATURE_INSIGHTS_RAIL=true
COVEO_FEATURE_TOPIC_INSIGHT=true
COVEO_FEATURE_RELATED_QUERIES=true
COVEO_FEATURE_POPULAR_CONTENT=true
COVEO_FEATURE_QUERY_SUGGESTIONS=true
COVEO_FEATURE_RECENT_SEARCHES=false
COVEO_FEATURE_RESULT_BADGES=true
COVEO_FEATURE_RESULT_THUMBNAILS=true
COVEO_FEATURE_RESULT_QUICK_VIEW=false
COVEO_FEATURE_ANALYTICS=true
COVEO_FEATURE_ANALYTICS_EXPOSURE=true
COVEO_FEATURE_GENERATIVE_ENABLED=true
COVEO_FEATURE_GENERATIVE_CITATIONS=true
COVEO_FEATURE_GENERATIVE_FEEDBACK=true
COVEO_FEATURE_GENERATIVE_DISCLAIMER=true
COVEO_FEATURE_GENERATIVE_STREAMING=false
COVEO_FEATURE_TRENDING_ENABLED=true

# Public demo profile. Safe for client bundles because it contains no secrets.
# Supported: industrial-product-discovery, developer-documentation, customer-support, ecommerce, minimal.
NEXT_PUBLIC_DEMO_PROFILE=industrial-product-discovery

# Enables development-only query overrides such as ?profile=ecommerce&scenario=empty.
# Ignored in production.
COVEO_DEVELOPMENT_QUERY_OVERRIDES=true
