# Coveo organization receiving requests.
COVEO_ORGANIZATION_ID=

# Explicit auth mode. Use anonymous-api-key for the validated public Commerce path.
# Use search-token only with a server-only Authenticated Search API key.
COVEO_AUTH_MODE=anonymous-api-key

# Public anonymous key for browser-side Headless Commerce over public catalog data.
# App code must never derive this from a server-only key.
NEXT_PUBLIC_COVEO_ANONYMOUS_SEARCH_API_KEY=

# Server-only key for RGA and Technical Resources. Never expose with NEXT_PUBLIC_.
COVEO_PLATFORM_API_KEY=

# Server-only Authenticated Search API key used only when COVEO_AUTH_MODE=search-token.
COVEO_AUTHENTICATED_SEARCH_API_KEY=

# Optional override for non-standard search-token endpoints.
# COVEO_SEARCH_TOKEN_ENDPOINT=https://<ORG_ID>.org.coveo.com/rest/search/v2/token?organizationId=<ORG_ID>

# Search token context.
COVEO_SEARCH_HUB=assessment-search
COVEO_PIPELINE=
COVEO_USER_ID=anonymous
COVEO_IDENTITY_PROVIDER=Email Security Provider

# RoboMotion Headless Commerce context.
COVEO_COMMERCE_TRACKING_ID=robomotion
COVEO_COMMERCE_LANGUAGE=en
COVEO_COMMERCE_COUNTRY=GB
COVEO_COMMERCE_CURRENCY=GBP

# RGA and Technical Resources use the Search API through server routes.
COVEO_SEARCH_API_BASE_URL=https://platform-eu.cloud.coveo.com/rest/search/v2
COVEO_RGA_SEARCH_HUB=robomotion
COVEO_RGA_PIPELINE=default
COVEO_CONTENT_SEARCH_HUB=robomotion
COVEO_CONTENT_PIPELINE=default

# Optional UI/runtime flags.
COVEO_FEATURE_ANALYTICS=true
COVEO_FEATURE_GENERATIVE_ENABLED=false
COVEO_FEATURE_GENERATIVE_CITATIONS=true
COVEO_FEATURE_GENERATIVE_FEEDBACK=true
COVEO_FEATURE_GENERATIVE_DISCLAIMER=true
COVEO_FEATURE_GENERATIVE_STREAMING=false
COVEO_FEATURE_TRENDING_ENABLED=true
